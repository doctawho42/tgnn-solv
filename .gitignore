# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Environments
.venv/
venv/
*.conda/

# IDE
.idea/
*.iml
.vscode/

# Data & checkpoints (large files)
data/raw/
data/processed/
notebooks/data/raw/
notebooks/data/processed/
checkpoints/*.pt
*.pt
*.pth
logs/
results/*
!results/.gitkeep
# Keystone reproducibility artifact (paper Table 2 / sec:measure); tracked on purpose.
!results/b_insuff
results/b_insuff/*
!results/b_insuff/matched_pairs.csv
!results/b_insuff/decomposition.json
# Named as its source by App. C (the input-fixed kernel control) and by the binning
# enumeration the main text quotes; tracked so a reader can open what the paper cites.
!results/b_insuff/fidelity_lever_inputfixed.json
!results/b_insuff/binning_conventions.json
# The admissibility of every stratum in the map -- which cells may be stated as a finding and
# which are reported only -- and the overlap between strata that decides what may not be
# counted twice.  Regenerated by the same script as the map, so a claim and its admissibility
# travel together; tracked because the map's verdicts are unreadable without them.
!results/b_insuff/admissibility_table.csv
!results/b_insuff/admissibility.json
!results/b_insuff/stratum_overlap.csv
# The constant-offset control that qualifies the transfer ratio of Sec. 6.4 / App. E.
# Small, and it is the only source for a number the paper prints, so it is versioned.
!results/compensation
results/compensation/*
!results/compensation/offset_control.json
figures/*
!figures/.gitkeep

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata

# OS
.DS_Store
Thumbs.db

# Superpowers SDD scratch (ledger, briefs, reports)
.superpowers/

# Generated docs site (mkdocs build) & compiled JS bundles
site/
docs/assets/javascripts/*.bundle.js

# Codebase-memory index artifact (regenerable; large binary)
.codebase-memory/

# Vendored / generated / scratch (repo-hygiene 2026-07)
node_modules/
**/node_modules/
tmp/
checkpoints/
.agents/
.claude/
.pytest_cache/
.ruff_cache/
test-results/
notebooks/data/processed_*/
.tmp_ann_*.txt
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz

# GSD planning layer (local-only)
.planning/

# LaTeX build aux (paper/)
*.bbl
*.blg
paper/*.log
reports/*.log
*.out
*.xdv
*.toc
# achemso writes an auto-generated <jobname> bib stub next to the manuscript; its own first
# line says it may safely be deleted.
paper/acs-*.bib

# Per-arm metrics behind Figure 2 and its rows of Table 2. The per-row prediction files are ~5 MB
# each and go to the archive; these summaries are what a reader needs to recompute every number the
# figure prints, so they are versioned.
!results/e5_sigma_grounding
results/e5_sigma_grounding/*
!results/e5_sigma_grounding/seed_42
!results/e5_sigma_grounding/seed_43
!results/e5_sigma_grounding/seed_44
results/e5_sigma_grounding/seed_4?/*
!results/e5_sigma_grounding/seed_4?/comparison.json
!results/e5_sigma_grounding/seed_4?/*.summary.json
!results/e5_sigma_grounding/THREE_SEED_SUMMARY.md
